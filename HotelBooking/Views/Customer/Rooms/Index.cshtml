@model List<HotelBooking.Models.Room>

@{
    ViewData["Title"] = "Available Rooms";
}

<div class="rooms-wrapper">
    <div class="page-title-box">
        <h2>Explore Our Rooms</h2>
        <p>Find the best room for your stay</p>
    </div>

    <!-- filter -->
    <div class="filter-box">
        <form method="get" asp-action="Index" class="filter-form">
            <select name="type" class="filter-select">
                <option value="">All Room Types</option>
                <option value="Single" selected="@(ViewBag.SelectedType == "Single")">Single</option>
                <option value="Double" selected="@(ViewBag.SelectedType == "Double")">Double</option>
                <option value="Suite" selected="@(ViewBag.SelectedType == "Suite")">Suite</option>
            </select>
            <button type="submit" class="btn-filter">Filter</button>
        </form>
    </div>

    <!-- roms in cards -->
    <div class="rooms-grid">
        @if (!Model.Any())
        {
            <div class="no-rooms">
                <h4>No rooms available at the moment.</h4>
            </div>
        }
        else
        {
            @foreach (var room in Model)
            {
                <div class="room-card-item">
                    <div class="card-content">
                        <h3>Room @room.RoomNumber</h3>
                        <p class="hotel-name">@room.Hotel?.Name</p>

                        <div class="room-info">
                            <span class="type-badge">@room.Type</span>
                            <div class="price-box">
                                <span class="price-amount">$@room.PricePerNight</span>
                                <span class="price-label">/ night</span>
                            </div>
                        </div>

                        <a asp-action="Details" asp-route-id="@room.Id" class="btn-details">
                            Show Details
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .rooms-wrapper {
        min-height: 85vh;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .page-title-box {
        text-align: center;
        margin-bottom: 2rem;
        color: #fff;
    }

    .page-title-box h2 {
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .page-title-box p {
        opacity: 0.8;
        margin: 0;
    }

    .filter-box {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        padding: 1.25rem;
        border-radius: 12px;
        max-width: 550px;
        margin: 0 auto 2.5rem auto;
    }

    .filter-form {
        display: flex;
        gap: 0.75rem;
    }

    .filter-select {
        flex: 1;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        border: 1px solid #ddd;
        outline: none;
    }

    .btn-filter {
        background: #2d2d3a;
        color: #fff;
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-filter:hover {
        background: #1a1a24;
    }

    .rooms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .no-rooms {
        grid-column: 1 / -1;
        text-align: center;
        color: #fff;
        padding: 2rem;
    }

    .room-card-item {
        background: #fff;
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .card-content h3 {
        color: #2d2d3a;
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .hotel-name {
        color: #8a8a99;
        font-size: 0.9rem;
        margin-bottom: 1.25rem;
    }

    .room-info {
        margin-bottom: 1.5rem;
    }

    .type-badge {
        background: #667eea;
        color: #fff;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 0.75rem;
    }

    .price-box {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
    }

    .price-amount {
        color: #764ba2;
        font-size: 1.4rem;
        font-weight: 700;
    }

    .price-label {
        color: #8a8a99;
        font-size: 0.85rem;
    }

    .btn-details {
        display: block;
        width: 100%;
        text-align: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        text-decoration: none;
        padding: 0.75rem;
        border-radius: 10px;
        font-weight: 600;
    }

    .btn-details:hover {
        opacity: 0.9;
        color: #fff;
    }

    @@media (max-width: 576px) {
        .filter-form {
            flex-direction: column;
        }
    }
</style>