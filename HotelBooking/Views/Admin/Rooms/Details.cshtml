@model HotelBooking.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<div class="room-wrapper">
    <div class="room-card">
        <div class="room-header">
            <h2>Room Details</h2>
            <p>View room information</p>
        </div>

        <div class="room-details">
            <div class="detail-row">
                <span>Room Number</span>
                <strong>@Model.RoomNumber</strong>
            </div>

            <div class="detail-row">
                <span>Room Type</span>
                <strong>@Model.Type</strong>
            </div>

            <div class="detail-row">
                <span>Price Per Night</span>
                <strong>@Model.PricePerNight</strong>
            </div>

            <div class="detail-row">
                <span>Status</span>

                @if (Model.IsActive)
                {
                    <span class="status active">Active</span>
                }
                else
                {
                    <span class="status inactive">Inactive</span>
                }
            </div>

            <div class="detail-row">
                <span>Hotel</span>
                <strong>@Model.Hotel?.Name</strong>
            </div>
        </div>

        <div class="room-actions">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-room">
                Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                Delete
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>
    </div>
</div>

<style>
    .room-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .room-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
        padding: 2.5rem;
        width: 100%;
        max-width: 550px;
    }

    .room-header {
        text-align: center;
        margin-bottom: 2rem;
    }

        .room-header h2 {
            font-weight: 700;
            color: #2d2d3a;
            margin-bottom: 0.4rem;
        }

        .room-header p {
            color: #8a8a99;
            font-size: 0.95rem;
            margin: 0;
        }

    .room-details {
        background: #f8f8fc;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid #e2e2ea;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row span:first-child {
            color: #8a8a99;
        }

        .detail-row strong {
            color: #2d2d3a;
            text-align: right;
        }

    .status {
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

        .status.active {
            background: #d1fae5;
            color: #047857;
        }

        .status.inactive {
            background: #fee2e2;
            color: #b91c1c;
        }

    .room-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

        .room-actions .btn {
            flex: 1;
            min-width: 100px;
            text-align: center;
            border-radius: 10px;
            padding: 0.75rem;
            font-weight: 600;
        }

    .btn-room {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        border: none;
    }

        .btn-room:hover {
            opacity: 0.9;
            color: #fff;
        }

    .btn-danger {
        border-radius: 10px;
        font-weight: 600;
    }

    .btn-secondary {
        border-radius: 10px;
        font-weight: 600;
    }

    @@media (max-width: 576px) {
        .room-card {
            padding: 1.5rem;
        }

        .detail-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.25rem;
        }

            .detail-row strong {
                text-align: left;
            }
    }
</style>