@model List<HotelBooking.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<div class="rooms-wrapper">
    <div class="rooms-header">
        <div>
            <h2>Rooms</h2>
            <p>Manage all hotel rooms</p>
        </div>

        <a asp-action="Create" class="btn btn-room">
            Add New Room
        </a>
    </div>

    <div class="rooms-card">
        <div class="table-responsive">
            <table class="table rooms-table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Room Number</th>
                        <th>Type</th>
                        <th>Price Per Night</th>
                        <th>Status</th>
                        <th>Hotel</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var room in Model)
                    {
                        <tr>
                            <td>@room.Id</td>
                            <td>@room.RoomNumber</td>
                            <td>@room.Type</td>
                            <td>@room.PricePerNight</td>

                            <td>
                                @if (room.IsActive)
                                {
                                    <span class="status active">Active</span>
                                }
                                else
                                {
                                    <span class="status inactive">Inactive</span>
                                }
                            </td>

                            <td>@room.Hotel?.Name</td>

                            <td>
                                <div class="action-buttons">
                                    <a asp-action="Details"
                                       asp-route-id="@room.Id"
                                       class="btn btn-sm btn-details">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@room.Id"
                                       class="btn btn-sm btn-edit">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@room.Id"
                                       class="btn btn-sm btn-delete">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .rooms-wrapper {
        padding: 2rem 1rem;
        min-height: 85vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .rooms-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

        .rooms-header h2 {
            color: #fff;
            font-weight: 700;
            margin-bottom: 0.4rem;
        }

        .rooms-header p {
            color: rgba(255, 255, 255, 0.85);
            margin: 0;
        }

    .rooms-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
        padding: 1.5rem;
    }

    .rooms-table {
        margin-bottom: 0;
        white-space: nowrap;
    }

        .rooms-table thead th {
            color: #2d2d3a;
            font-weight: 700;
            border-bottom: 2px solid #e2e2ea;
        }

        .rooms-table tbody td {
            color: #555;
            vertical-align: middle;
        }

        .rooms-table tbody tr:hover {
            background-color: #f8f8fc;
        }

    .status {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .status.active {
            background: #d1fae5;
            color: #047857;
        }

        .status.inactive {
            background: #fee2e2;
            color: #b91c1c;
        }

    .action-buttons {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

        .action-buttons .btn {
            border-radius: 8px;
            font-weight: 600;
        }

    .btn-room {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.75rem 1.2rem;
        font-weight: 600;
    }

        .btn-room:hover {
            opacity: 0.9;
            color: #fff;
        }

    .btn-details {
        background: #e0e7ff;
        color: #4338ca;
    }

    .btn-edit {
        background: #fef3c7;
        color: #92400e;
    }

    .btn-delete {
        background: #fee2e2;
        color: #b91c1c;
    }

        .btn-details:hover,
        .btn-edit:hover,
        .btn-delete:hover {
            opacity: 0.85;
        }

    @@media (max-width: 768px) {
        .rooms-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .rooms-card {
            padding: 1rem;
        }
    }
</style>