@model HotelBooking.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="room-wrapper">
    <div class="room-card">
        <div class="room-header">
            <h2>Delete Room</h2>
            <p>Are you sure you want to delete this room?</p>
        </div>

        <div class="delete-info">
            <p>
                You are about to delete room:
                <strong>@Model.RoomNumber</strong>
            </p>

            <p>
                Room Type:
                <strong>@Model.Type</strong>
            </p>

            <p>
                Price Per Night:
                <strong>@Model.PricePerNight</strong>
            </p>
        </div>

        <form asp-action="Delete" method="post" class="room-form">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger w-100">
                Delete Room
            </button>
        </form>

        <div class="room-footer">
            <a asp-action="Index">Cancel</a>
        </div>
    </div>
</div>

<style>
    .room-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .room-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
        padding: 2.5rem;
        width: 100%;
        max-width: 500px;
    }

    .room-header {
        text-align: center;
        margin-bottom: 2rem;
    }

        .room-header h2 {
            font-weight: 700;
            color: #2d2d3a;
            margin-bottom: 0.4rem;
        }

        .room-header p {
            color: #8a8a99;
            font-size: 0.95rem;
        }

    .delete-info {
        background: #f8f8fc;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        color: #555;
    }

        .delete-info p {
            margin-bottom: 0.5rem;
        }

            .delete-info p:last-child {
                margin-bottom: 0;
            }

    .btn-danger {
        border-radius: 10px;
        padding: 0.85rem;
        font-weight: 600;
    }

    .room-footer {
        text-align: center;
        margin-top: 1.5rem;
    }

        .room-footer a {
            color: #764ba2;
            font-weight: 600;
            text-decoration: none;
        }

            .room-footer a:hover {
                text-decoration: underline;
            }
</style>