@model HotelBooking.Models.Hotel

@{
    ViewData["Title"] = "Delete Hotel";
}

<div class="hotel-wrapper">
    <div class="hotel-card">
        <div class="hotel-header">
            <h2>Delete Hotel</h2>
            <p>Are you sure you want to delete this hotel?</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="mb-3 text-center">
                <img src="@Model.ImagePath" alt="@Model.Name" class="delete-image" />
            </div>
        }

        <div class="delete-info">
            <p>
                Name:
                <strong>@Model.Name</strong>
            </p>

            <p>
                Address:
                <strong>@Model.Address</strong>
            </p>

            <p>
                City:
                <strong>@Model.City</strong>
            </p>
        </div>

        <form asp-action="Delete" method="post" class="hotel-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger w-100">
                Delete Hotel
            </button>
        </form>

        <div class="hotel-footer">
            <a asp-action="Index">Cancel</a>
        </div>
    </div>
</div>

<style>
    .hotel-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .hotel-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
        padding: 2.5rem;
        width: 100%;
        max-width: 500px;
    }

    .hotel-header {
        text-align: center;
        margin-bottom: 2rem;
    }

        .hotel-header h2 {
            font-weight: 700;
            color: #2d2d3a;
            margin-bottom: 0.4rem;
        }

        .hotel-header p {
            color: #8a8a99;
            font-size: 0.95rem;
        }

    .delete-image {
        max-width: 200px;
        max-height: 150px;
        object-fit: cover;
        border-radius: 10px;
    }

    .delete-info {
        background: #f8f8fc;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        color: #555;
    }

        .delete-info p {
            margin-bottom: 0.5rem;
        }

            .delete-info p:last-child {
                margin-bottom: 0;
            }

    .btn-danger {
        border-radius: 10px;
        padding: 0.85rem;
        font-weight: 600;
    }

    .hotel-footer {
        text-align: center;
        margin-top: 1.5rem;
    }

        .hotel-footer a {
            color: #764ba2;
            font-weight: 600;
            text-decoration: none;
        }

            .hotel-footer a:hover {
                text-decoration: underline;
            }
</style>