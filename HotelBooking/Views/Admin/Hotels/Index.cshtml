@model List<HotelBooking.Models.Hotel>

@{
    ViewData["Title"] = "Hotels";
}

<h2>Hotels</h2>

<a asp-action="Create" class="btn btn-primary">Add New Hotel</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Address</th>
            <th>City</th>
            <th>Description</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hotel in Model)
        {
            <tr>
                <td>@hotel.Id</td>
                <td>@hotel.Name</td>
                <td>@hotel.Address</td>
                <td>@hotel.City</td>
                <td>@hotel.Description</td>
                <td>@hotel.CreatedAt</td>
                <td>
                    <a asp-action="Details" asp-route-id="@hotel.Id" class="btn btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@hotel.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@hotel.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>